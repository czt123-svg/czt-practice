1//和可被k整除的子数组
class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        HashMap<Integer,Integer> map = new HashMap<>();
        int sum = 0,res = 0;
        map.put(0,1);
        for (int x : nums){
            sum+=x;
            int r = (sum % k + k)%k;
            res += map.getOrDefault(r,0);
            map.put(r,map.getOrDefault(r,0)+1);
        }
        return res;
    }
}
