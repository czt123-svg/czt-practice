3//除自身以外数组的乘积(前后)
class Solution {
    public int[] productExceptSelf(int[] nums) {
    int n = nums.length;
     int [] f = new int[n];
     int [] g = new int[n];
     f[0]= g[n-1]=1;
    for(int i= 1;i < n;i++){
      f[i] = f[i-1] * nums[i-1];
    }
     for(int i= n-2;i >= 0 ;i--){
        g[i] = g[i+1]*nums[i+1];
    }
    int [] answer = new int [n];
    for(int i = 0;i < n ;i++){
        answer [i] = f[i]*g[i];
    }
    return answer;   
    }
}
4//寻找数组中心下标
class Solution {
    public int pivotIndex(int[] nums) {
        int n = nums.length;
        long[] dp = new long[n + 1];
        //创建前缀和数组
        for (int i = 1; i <= n; i++) {
            dp[i] = dp[i - 1] + nums[i - 1];
        }
        //查询数组
        int i = 1;
        for (i = 1; i < n; i++) {
            long res = dp[n] - dp[i];
            if (dp[i - 1] == res) {
                break;
            }
        }
        if (i == n && dp[i - 1] != 0) {
            return -1;
        } else {
            return i - 1;
        }
    }
}
5//连续数组
class Solution {
    public int findMaxLength(int[] nums) {
        Map<Integer,Integer> map = new HashMap<>();
        map.put(0,-1);
        int sum=0,ret = 0;
        for(int i = 0;i < nums.length;i++){
            sum+= (nums[i] == 0 ? -1:nums[i]);
            if(map.containsKey(sum)) ret = Math.max(ret,i-map.get(sum));
            else map.put(sum,i);
        }
        return ret;
    }
}
//矩阵区域和
class Solution {
    public int[][] matrixBlockSum(int[][] mat, int k) {
        int m = mat.length,n= mat[0].length;
        int [][] dp = new int[m+1][n+1];
        int anc [][] = new int [m][n];
        //将二维前缀和数组dp初始化
        for(int i = 1;i <= m;i++){
            for(int j=1;j<= n;j++){
                dp[i][j] = dp[i][j-1]+dp[i-1][j]-dp[i-1][j-1]+mat[i-1][j-1];
            }
        }
        //使用dp数组
        for(int i = 0;i < m;i++){
            for(int j = 0;j< n;j++){
                int x1 = Math.max(0,i-k)+1,y1 = Math.max(0,j-k)+1;
                int x2 = Math.min(m-1,i+k)+1,y2 = Math.min(n-1,j+k)+1;
                anc[i][j] =dp[x2][y2]-dp[x1-1][y2]-dp[x2][y1-1]+dp[x1-1][y1-1];
            }
        }

        return anc;
    }
}
