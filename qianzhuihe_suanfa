3//除自身以外数组的乘积(前后)
class Solution {
    public int[] productExceptSelf(int[] nums) {
    int n = nums.length;
     int [] f = new int[n];
     int [] g = new int[n];
     f[0]= g[n-1]=1;
    for(int i= 1;i < n;i++){
      f[i] = f[i-1] * nums[i-1];
    }
     for(int i= n-2;i >= 0 ;i--){
        g[i] = g[i+1]*nums[i+1];
    }
    int [] answer = new int [n];
    for(int i = 0;i < n ;i++){
        answer [i] = f[i]*g[i];
    }
    return answer;   
    }
}
4//寻找数组中心下标
class Solution {
    public int pivotIndex(int[] nums) {
        int n = nums.length;
        long[] dp = new long[n + 1];
        //创建前缀和数组
        for (int i = 1; i <= n; i++) {
            dp[i] = dp[i - 1] + nums[i - 1];
        }
        //查询数组
        int i = 1;
        for (i = 1; i < n; i++) {
            long res = dp[n] - dp[i];
            if (dp[i - 1] == res) {
                break;
            }
        }
        if (i == n && dp[i - 1] != 0) {
            return -1;
        } else {
            return i - 1;
        }
    }
}
